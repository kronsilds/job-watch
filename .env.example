# Local/mock default: leave provider unset. Never commit secrets.
JOBWATCH_DATABASE_URL=sqlite:///./jobwatch.db
# Optional CV/profile analysis and assisted writing. Use a server-side secret only.
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# Heavy model for deep tasks (CV analysis, market synthesis):
# LLM_MODEL_HEAVY=openai/gpt-4o
# Light model for fast writing tasks (pitch/email):
# LLM_MODEL_LIGHT=openai/gpt-4o-mini
# Fallback single model if heavy/light are not set:
# LLM_MODEL=gpt-5-mini
# Anthropic (Claude) — alternative au endpoint OpenAI-compatible ci-dessus.
# Activer avec LLM_PROVIDER=anthropic (ou laisser auto : détecté si une seule
# famille de clés est présente). Le SDK `anthropic` est optionnel : sans lui,
# les appels passent en HTTP direct (httpx) vers la Messages API.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# LLM_MODEL_HEAVY=claude-sonnet-5-5
# LLM_MODEL_LIGHT=claude-haiku-5-5
#   (LLM_API_KEY est accepté comme clé de secours pour Anthropic)
#   Taille max des réponses JSON (défaut 4096) :
# LLM_MAX_TOKENS=4096
#   Connexion avec un compte Claude (Pro/Max) en OAuth — bearer, sans x-api-key :
#     1. GET /api/oauth/claude/authorize puis connexion dans le navigateur ;
#     2. tokens stockés dans data/claude_oauth_tokens.json (refresh automatique).
#   Bearer statique alternatif (ex. jeton `claude setup-token`) :
# ANTHROPIC_AUTH_TOKEN=
#   Réglages OAuth (rarement nécessaires) :
# ANTHROPIC_OAUTH_REDIRECT_URI=http://localhost:8000/callback
# ANTHROPIC_OAUTH_TOKENS_FILE=
# ANTHROPIC_OAUTH_BETA=oauth-2025-04-20
# Notation finale des offres par Jev (TypeSafe) via la Decisions API OpenRouter
# (https://openrouter.ai/docs/guides/community/jev-tutorial) :
#   sans clé, la note reste heuristique (gratuite, hors réseau).
# OPENROUTER_API_KEY=sk-or-...
#   Point d'entrée Decisions API — POST {base}/alpha/decisions :
# JEV_BASE_URL=https://openrouter.ai/api
#   Modèle épinglé (alias autorisé : ~typesafe/jev-latest) :
# JEV_MODEL=typesafe/jev-1.13
#   auto (défaut : Jev si clé) | jev | heuristic
# JOBWATCH_SCORER=auto
#   Requêtes Jev parallèles et délai par requête (s) :
# JOBWATCH_JEV_WORKERS=4
# JOBWATCH_JEV_TIMEOUT=30
# Boucle Rédacteur ↔ Évaluateur (LangGraph) — pitch / CV ATS itératifs :
#   Note de validation de l'évaluateur (sur 10, défaut 6) :
# JOBWATCH_REFINE_THRESHOLD=6
#   Plafond anti-boucle infinie (défaut 5, meilleure version sauvegardée) :
# JOBWATCH_REFINE_MAX_ITER=5
#   Tentatives par appel LLM en cas d'erreur transitoire (défaut 2) :
# JOBWATCH_REFINE_LLM_ATTEMPTS=2
# Connecteurs de veille (facultatifs) :
#   France Travail (API officielle, token OAuth) — sans jeton, la page de
#   recherche classique est utilisée en repli :
# FRANCE_TRAVAIL_TOKEN=
#   Adzuna (API publique) — sans clés, la page de recherche HTML est utilisée :
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# Veille web « fair use » (LinkedIn, Indeed, WTTJ, APEC, HelloWork + replis
# HTML France Travail / Adzuna) : usage personnel, quelques requêtes par jour.
#   Délai aléatoire entre requêtes (secondes) :
# JOBWATCH_WEB_DELAY_MIN=2
# JOBWATCH_WEB_DELAY_MAX=5
#   Quota quotidien de requêtes sortantes :
# JOBWATCH_WEB_DAILY_LIMIT=30
#   Durée de vie du cache disque (secondes, 6 h par défaut) :
# JOBWATCH_WEB_CACHE_TTL=21600
#   Nombre max d'offres conservées par source :
# JOBWATCH_WEB_MAX_PER_SOURCE=50
#   Nb de shards sitemap WTTJ téléchargés (1 à 3) :
# JOBWATCH_WTTJ_SITEMAP_SHARDS=1
#   Politique robots.txt : fair (défaut, accès minimal tracé) ou strict (refus) :
# JOBWATCH_WEB_ROBOTS_POLICY=fair
#   User-Agent honnête (ASCII) envoyé aux sites :
# JOBWATCH_WEB_UA=JobWatch/0.3 (personal job-search watcher; non-commercial; a few requests per day) python-httpx
OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/oauth/callback
# Multi-utilisateurs (option B : comptes locaux, annonces partagées, notations
# personnelles) : par défaut l'API exige un compte (Bearer token). Pour retrouver
# le comportement mono-utilisateur historique (données user_id IS NULL) :
# JOBWATCH_SINGLE_USER=1
# Configure only public OAuth client IDs through a secret manager in real deployments:
# JOBWATCH_GMAIL_CLIENT_ID=
# JOBWATCH_OUTLOOK_CLIENT_ID=
